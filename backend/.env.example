# Support Brain — Backend Environment Variables Template
# Copy this to .env and replace with your actual values

# ─── LLM Provider (Ollama or Gemini) ──────────────────────────
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ─── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Supabase PostgreSQL (with pgvector) ─────────────────────
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Gmail OAuth 2.0 ──────────────────────────────────────────
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# ─── Application Security ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=your_random_32_byte_secret_key

# ─── Gmail Token Encryption (Fernet) ─────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_32_url_safe_base64_key=

# ─── Application URLs ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
