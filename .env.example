# Support Brain — Backend Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to Git!

# ─── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Supabase PostgreSQL (with pgvector) ─────────────────────
# Format: postgresql+asyncpg://postgres:PASSWORD@HOST:PORT/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ─── Application Security & JWT Authentication ────────────────
JWT_SECRET_KEY=your-32-byte-hex-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_SECRET_KEY=your-app-secret-key-here

# ─── Gmail OAuth 2.0 ──────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# ─── Gmail Token Encryption (Fernet) ─────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key-here

# ─── Application URLs ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
